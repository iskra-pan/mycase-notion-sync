# Copy to .env for local dev. On Cloud Run, set these as env vars / Secret Manager
# secrets instead - never bake real secrets into the image or commit .env.

MYCASE_CLIENT_ID=
MYCASE_CLIENT_SECRET=
# Must exactly match the redirect URI MyCase support has on file for this client_id.
MYCASE_REDIRECT_URI=http://localhost:8080/auth/mycase/callback

# Random long string - used to sign the OAuth "state" param and to protect
# the internal /auth/mycase/internal/refresh endpoint. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_TASK_SECRET=

# Needed only once you deploy (enables Firestore token storage). Leave blank
# for local dev - it'll fall back to a local JSON file automatically.
GCP_PROJECT_ID=

# TODO CONFIRM: the real MyCase data-API host (not auth.mycase.com - that's
# OAuth only). See app/mycase_client.py's module docstring.
MYCASE_API_BASE=

# Notion internal integration - Settings -> Connections -> Develop or manage
# integrations -> New integration. Then "Share" the case-tracking database
# with it and copy the database ID from its URL.
NOTION_TOKEN=
NOTION_DATABASE_ID=
